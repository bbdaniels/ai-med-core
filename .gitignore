# Dependencies
node_modules/
dist/

# Environment variables. The glob is deliberate: an enumerated list let
# .env.staging, .env.prod, and .env.bak be tracked by accident. env.example has
# no leading dot and stays tracked.
.env
.env.*

# Credentials of any kind, never tracked.
*.pem
*.key
*.p12
service-account*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Chat transcripts
transcripts/

# Deployment-specific configuration
**/languages.json
!projects/**/languages.json
# core/ holds the public mirror's overrides, which are source, not generated
# output. Without this the demo project's languages.json is silently untracked
# and the mirror publishes an incomplete demo.
!core/**/languages.json
local-dev.db

# Datbase backups
backups/

# Eval pipeline intermediate files (regenerated by fetch_transcripts.py)
**/eval/_work/

# Built Kobo forms (regenerated by kobo/build_form.py)
kobo/forms/
projects/**/forms/*.xlsx
# Claude Code local config
.claude/
.gstack/
