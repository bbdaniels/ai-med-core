# Environment Variables
# Chat/grading key. With OPENAI_BASE_URL set, this routes through the Harvard
# HDSI gateway (metered Harvard credits); without it, direct OpenAI.
OPENAI_API_KEY=your_openai_api_key_here
# Harvard HDSI gateway URL. Omit for direct OpenAI. The gateway only proxies
# standard chat-completions models — NOT /audio/speech (TTS) or the Realtime API.
# OPENAI_BASE_URL=https://your-gateway-host.example.com/v1

# Direct OpenAI key for endpoints the Harvard gateway cannot carry. Always hits
# api.openai.com directly (never the gateway), so it bills this key's OpenAI org.
# Used by TTS (/audio/speech) and, by default, the Realtime API.
# OPENAI_TTS_KEY=sk-...

# OpenAI Realtime API (speech-to-speech voice). Realtime CANNOT use the Harvard
# gateway — its credit-redemption proxy rejects realtime models, and the audio
# media flows browser↔OpenAI directly. So realtime always uses a DIRECT key:
# OPENAI_REALTIME_KEY if set, else OPENAI_TTS_KEY. Set this to a dedicated key
# (e.g. a Harvard direct-org key, if available) for separate cost tracking.
# OPENAI_REALTIME_KEY=sk-...
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_VOICE=alloy
# Per-session auto-disconnect (seconds) the frontend enforces as a cost cap.
# OPENAI_REALTIME and audio are billed per-minute on the direct key.
# REALTIME_MAX_SESSION_SECONDS=600

NODE_ENV=development
PORT=3001

# Admin Configuration
ADMIN_PASSPHRASE=your-secure-passphrase-here
# JWT secret for signing admin tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here-change-in-production

# Database Configuration
# For local development (SQLite):
DATABASE_URL=sqlite://./local-dev.db
# For production (PostgreSQL on Digital Ocean):
# DATABASE_URL=postgresql://user:password@host:port/database

# Table naming (optional prefix for shared databases)
TABLE_PREFIX=

# KoboToolbox API (for writing transcripts to submissions)
KOBO_API_TOKEN=
# KoboToolbox base URL — override only if pointing at a self-hosted install.
# Default is the SaaS kf host. All runtime calls (XForm fetch, submission search,
# bulk update, OpenRosa submission POST) go through this host.
# KOBO_KF_BASE=https://kf.kobotoolbox.org

# CORS Configuration
# Leave empty if frontend and backend are served from the same domain (typical setup).
# Only set if you need to allow cross-origin API access from external domains.
# Comma-separated list of exact origins. Examples:
# ALLOWED_ORIGINS=https://external-app.com,https://partner-site.com
# Note: In development, http://localhost:3000 and http://127.0.0.1:3000 are auto-allowed.
ALLOWED_ORIGINS=

# Deployment URL (for push-content tool)
# The base URL of the production deployment. Used by tools/push-content.ts
# to push project content. Can also use --url flag or --local for localhost.
# DEPLOY_URL=https://your-api-host.example.com
DEPLOY_URL=

# Frontend Serving (monorepo)
# Set to 'false' to run the API as a standalone service (frontend deployed separately).
# Default is 'true' — the API serves the frontend static files in production.
SERVE_FRONTEND=true
# Override the directory for static files (default: packages/frontend-chat/dist)
# STATIC_DIR=
